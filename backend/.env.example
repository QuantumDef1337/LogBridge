# LogBridge backend environment variables
# Copy this file to .env and fill in your values

# Port the API server listens on (default: 4000)
PORT=4000

# JWT signing secret — use a long random string (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# AES-256-GCM key for encrypting stored credentials (64 hex chars = 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOGBRIDGE_ENCRYPTION_KEY=change-me-to-64-hex-chars
